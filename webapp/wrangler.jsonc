// Hotmonitor: one Worker serving the static app (public/) and the API (/api/*).
// See CONTRACT.md for the data/API contract and DEPLOY.md for setup.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hotmonitor",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-30",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hotmonitor",
      "database_id": "e01d5fd4-136e-4db8-81f8-c360ffab04cf",
      "migrations_dir": "migrations"
    }
  ],
  // Auth is fail-closed: until TEAM_DOMAIN and ACCESS_AUD are set, every
  // /api request is refused. DEV_AUTH_* bypasses live only in .dev.vars.
  // Access only proves the email (one-time PIN); who gets in is decided by
  // the D1 users table (CONTRACT.md, Version 2).
  "vars": {
    "TEAM_DOMAIN": "crimson-frog-4f56.cloudflareaccess.com",
    "ACCESS_AUD": "4927acc83722928ac8ca01ece8466a3e92da19bb282814c635ff27363320e3a6",
    "MACHINE_CLIENT_ID": "a31ef3f6c5b1989fb694ca7ad6ce0bbf.access",
    "SERVICE_TOKEN_EXPIRES": "2027-09-30",
    // The scheduled runs are started here (CONTRACT.md, Version 3.8), with
    // the Worker secret GITHUB_DISPATCH_TOKEN: a fine-grained token for this
    // repo only, with Actions read and write.
    "GITHUB_REPO": "jeaneclaude621-ui/threat_monitor",
    // OWNER (always an active admin, break-glass) and the optional ADMINS/
    // READERS seed lists are Worker secrets so no address lives in this repo.
    // Web Push (CONTRACT.md, Version 3). The private key is the Worker
    // secret VAPID_PRIVATE_KEY (wrangler secret put), never in this file.
    "VAPID_PUBLIC_KEY": "BK26uWj_E45yGG0S4xHUSPeoVnbYb2pawCH2rkHpsU4yaQE5rSSkq7zEOoaadkGte6na53T2dbC_WBrB6mCFFqM"
  },
  // Missing-report alarm: every 30 min 03:00-09:30 UTC; the handler itself
  // checks Stockholm local time (DST-safe), so the UTC window covers both
  // CET and CEST. Then the cron that starts the scheduled runs on GitHub
  // Actions (DISPATCH_CRON in worker.js, which must match it): both UTC
  // hours of 04:00, 12:00, 16:00 and 21:00 Stockholm time.
  "triggers": { "crons": ["*/30 3-9 * * *", "0 2,3,10,11,14,15,19,20 * * *"] }
}
