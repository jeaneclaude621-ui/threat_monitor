// Hotmonitor: one Worker serving the static app (public/) and the API (/api/*).
// See CONTRACT.md for the data/API contract and DEPLOY.md for setup.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hotmonitor",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-30",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hotmonitor",
      "database_id": "e01d5fd4-136e-4db8-81f8-c360ffab04cf",
      "migrations_dir": "migrations"
    }
  ],
  // Auth is fail-closed: until TEAM_DOMAIN and ACCESS_AUD are set, every
  // /api request is refused. DEV_AUTH_* bypasses live only in .dev.vars.
  // Access only proves the email (one-time PIN); who gets in is decided by
  // the D1 users table (CONTRACT.md, Version 2).
  "vars": {
    "TEAM_DOMAIN": "crimson-frog-4f56.cloudflareaccess.com",
    "ACCESS_AUD": "4927acc83722928ac8ca01ece8466a3e92da19bb282814c635ff27363320e3a6",
    "ADMINS": "admin.one@example.org,admin.two@example.org,the.owner@example.org",
    "READERS": "reader.one@example.org,reader.two@example.org",
    "MACHINE_CLIENT_ID": "a31ef3f6c5b1989fb694ca7ad6ce0bbf.access",
    // Always an active admin, whatever the users table says (break-glass).
    // ADMINS/READERS only seed the users table the first time it is empty;
    // after that, people are managed on the app's admin page.
    "OWNER": "the.owner@example.org",
    "SERVICE_TOKEN_EXPIRES": "2027-09-30"
  }
}
