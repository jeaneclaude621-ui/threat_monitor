<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key><string>se.threatmonitor.daily</string>
	<!-- caffeinate -i -s holds the Mac awake for the job's duration:
	     without it the machine sleeps mid-run and suspends the process,
	     which delayed the report by ~3 hours on 25 and 26 Sep.
	     Sources ~/.zshrc so the API key and SMTP settings stay in one
	     place instead of being copied into this file. launchd runs a
	     missed job when the Mac wakes, which cron does not.
	     Calls the Command Line Tools python directly: /usr/bin/python3
	     is a shim that refuses to start until the Xcode license is
	     accepted, which killed the 29 Sep report after an Xcode change.
	     Goes through run_job.py, which syncs the run state with GitHub
	     and runs the job only while data/runner says "mac". -->
	<key>ProgramArguments</key>
	<array>
		<string>/bin/zsh</string>
		<string>-c</string>
		<string>source "$HOME/.zshrc"; exec /usr/bin/caffeinate -i -s /Library/Developer/CommandLineTools/usr/bin/python3 /Users/jeaneclaude/threat_monitor/schedule/run_job.py --host mac daily</string>
	</array>
	<key>WorkingDirectory</key><string>/Users/jeaneclaude/threat_monitor</string>
	<key>StartCalendarInterval</key>
	<array>
		<dict><key>Hour</key><integer>5</integer><key>Minute</key><integer>0</integer></dict>
	</array>
	<key>StandardOutPath</key><string>/Users/jeaneclaude/threat_monitor/data/logs/daily_run.log</string>
	<key>StandardErrorPath</key><string>/Users/jeaneclaude/threat_monitor/data/logs/daily_run.log</string>
</dict>
</plist>
