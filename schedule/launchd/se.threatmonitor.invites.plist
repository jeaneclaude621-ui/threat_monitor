<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key><string>se.threatmonitor.invites</string>
	<!-- Mails the invitations queued on the web app's admin page (the
	     Worker cannot send mail). One small HTTPS request every two
	     minutes; mail goes out only when something is queued. Same
	     ~/.zshrc and python as the other jobs (see the hourly plist). -->
	<key>ProgramArguments</key>
	<array>
		<string>/bin/zsh</string>
		<string>-c</string>
		<string>source "$HOME/.zshrc"; exec /Library/Developer/CommandLineTools/usr/bin/python3 /Users/jeaneclaude/threat_monitor/src/app_mail.py send-invites</string>
	</array>
	<key>WorkingDirectory</key><string>/Users/jeaneclaude/threat_monitor</string>
	<key>StartInterval</key><integer>120</integer>
	<key>StandardOutPath</key><string>/Users/jeaneclaude/threat_monitor/data/logs/invites.log</string>
	<key>StandardErrorPath</key><string>/Users/jeaneclaude/threat_monitor/data/logs/invites.log</string>
</dict>
</plist>
