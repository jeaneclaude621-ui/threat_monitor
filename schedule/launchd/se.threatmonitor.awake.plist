<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key><string>se.threatmonitor.awake</string>
	<!-- Keeps the Mac from sleeping while it is on the charger, so the
	     hourly monitor actually runs every hour and the web app's live
	     feed stays current. caffeinate -s only holds while on AC power:
	     on battery the Mac sleeps as usual. The display may still sleep.
	     A closed lid still sleeps the Mac unless an external display is
	     attached. Started at login, restarted if it ever exits. -->
	<key>ProgramArguments</key>
	<array>
		<string>/usr/bin/caffeinate</string>
		<string>-s</string>
	</array>
	<key>RunAtLoad</key><true/>
	<key>KeepAlive</key><true/>
</dict>
</plist>
